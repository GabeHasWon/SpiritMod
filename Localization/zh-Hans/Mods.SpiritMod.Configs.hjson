SpiritClientConfig: {
	DisplayName: 客户端配置

	ScreenShake: {
		Label: 屏幕震动
		Tooltip:
			'''
			修改由模组内容引起的屏幕震动的强度
			设为0以完全禁用
			'''
	}

	DistortionConfig: {
		Label: 屏幕失真
		Tooltip: 启用后，当处于魂灵之地或与星盘巡游者的战斗时会具有屏幕失真效果
	}

	ForegroundParticles: {
		Label: 前景粒子
		Tooltip: 启用后，在某些条件下，前景中会有额外的粒子
	}

	AutoReuse: {
		Label: 自动重新使用工具提示
		Tooltip: 在武器的工具提示中增加一行显示物品是否能够自动重新使用/自动挥舞的文本
	}

	QuickSell: {
		Label: 快速出售功能
		Tooltip: 启用快速出售功能，可以轻松地将所有不需要的物品出售给NPC
	}

	AmbientSounds: {
		Label: 环境音
		Tooltip: 为某些生物群系启用环境音效果
	}

	LeafFall: {
		Label: 落叶效果
		Tooltip:
			'''
			启用后，在安宁夜持续期间或处于荆棘之地时会具有落叶氛围
			禁用此功能以防止在游玩Terraria Overhaul时发生奇怪的交互
			'''
	}

	QuestBookLocation: {
		Label: 任务书按钮位置
		Tooltip: 更改任务书按钮在物品栏中的显示位置
	}

	QuestBookSwitching: {
		Label: 任务书标签切换
		Tooltip: 当任务被激活或完成时，从当前选项卡切换到激活选项卡或已完成选项卡
	}

	ShowNPCQuestNotice: {
		Label: 城镇NPC任务图标
		Tooltip: 启用后，当城镇NPC有新任务时会有一个任务感叹号
	}

	DoubleHideoutGeneration: {
		Label: 奥术塔和盗贼藏身处生成
		Tooltip:
			'''
			启用后，会同时生成盗贼藏身处和奥术塔
			默认情况下每个世界仅会生成二者中的一个
			仅推荐在游玩大世界时启用
			'''
	}

	OceanShape: {
		Label: 海洋生成形状
		Tooltip:
			'''
			以某些方式修改海洋生成
			默认为分段_V生成
			仅推荐在游玩魂灵模组时使用分段_V生成
			'''
	}

	VentCritters: {
		Label: 热液喷口生态系统
		Tooltip:
			'''
			启用后，允许小动物在热液喷口附近生成
			这些生物不会干扰敌人的正常生成
			然而，它们确实对最大NPC数量限制有所贡献
			'''
	}

	SurfaceWaterTransparency: {
		Label: 海水透明度
		Tooltip:
			'''
			启用后，允许海水透明
			不会影响任其他生物群系
			'''
	}

	EnemyFishing: {
		Label: 钓鱼遭遇
		Tooltip: 启用后，在钓鱼时会遭遇宝匣模仿者
	}

	AuroraEnabled: {
		Label: 极光
		Tooltip: 启用或禁用极光视觉效果。这并不能阻止基于极光的效果或敌人的出现
	}

	EnableSepulchres: {
		Label: 黑暗坟葬
		Tooltip: 启用或禁用在地下发现的黑暗坟葬结构。如果你遇到了其他模组的生成问题，可以关闭此功能
	}

	ForceClassicZiggurat: {
		Label: 强制庙塔
		Tooltip: 启用魂灵的庙塔生成，即使是启用魂灵新魄后。请注意，庙塔可能与其他结构重叠。
	}

	Headers: {
		Visuals: "[i:SpiritMod/MoonStone] 视觉"
		QoL: "[i:SpiritMod/PirateCrate] 生活质量"
		Ambience: "[i:SpiritMod/GladeWreath] 氛围"
		Quests: "[i:SpiritMod/MapScroll] 任务"
		Generation: "[i:SpiritMod/BismiteCrystal] 生成"
		Oceans: "[i:SpiritMod/BlackPearl] 海洋"
		Fishing: "[i:SpiritMod/HornetfishQuest] 钓鱼"
	}
}

QuestInvLocation: {
	Tooltip: ""

	Minimap: {
		Label: 小地图
		Tooltip: ""
	}

	Trashcan: {
		Label: 垃圾桶
		Tooltip: ""
	}

	FarLeft: {
		Label: 最左边
		Tooltip: ""
	}
}

OceanShape: {
	Tooltip: ""

	Default: {
		Label: 默认
		Tooltip: 原版的默认海洋生成。禁用魂灵的生成。
	}

	SlantedSine: {
		Label: 倾斜正弦
		Tooltip: 调整后的坡度，使用对角线正弦波生成。
	}

	Piecewise: {
		Label: 分段
		Tooltip: 结合了少许坡度的分段生成，原始的分段生成，但略显粗糙。
	}

	Piecewise_M: {
		Label: 分段_ M
		Tooltip: 调整的分段生成，略有改善。
	}

	Piecewise_V: {
		Label: 分段_ V
		Tooltip: 最终的分段生成，预期中的魂灵海洋生成。
	}
}

