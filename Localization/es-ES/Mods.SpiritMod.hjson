MiscUI: {
	AutoSell: Haz clic para vender rápidamente tus artículos
	SellLock:
		'''
		Cambia esto para bloquear la mecánica de venta rápida
		No podrás usar la venta rápida mientras esté activada
		'''
	SellWeapons: Activa esta opción para desactivar la venta de armas
	SellNoValue: Cambia esto para vender artículos "sin valor" con venta rápida
	Autofire: Disparo automático
	Autoswing: Oscilación automática
}

Keybinds: {
	"SpiritMod:QuestBookToggle.DisplayName": Spirit Mod: Alternar libro de misiones
	"SpiritMod:QuestHUDToggle.DisplayName": Spirit Mod: Alternar HUD de misiones
}

Configs: {
	SpiritClientConfig: {
		DisplayName: Client Config

		ScreenShake: {
			Label: "{$Mods.SpiritMod.Screenshake}"
			Tooltip:
				'''
				Modifica la intensidad del movimiento de pantalla aplicado por el contenido dentro del mod
				Establézcalo en 0 para deshabilitarlo por completo
				'''
		}

		DistortionConfig: {
			Label: "{$Mods.SpiritMod.Distortion}"
			Tooltip: Habilita la distorsión de la pantalla mientras estás en el Bioma Espiritual o cuando luchas contra el Starplate Voyager.
		}

		ForegroundParticles: {
			Label: "{$Mods.SpiritMod.Particles}"
			Tooltip: Habilita partículas adicionales en primer plano bajo ciertas condiciones
		}

		AutoReuse: {
			Label: "{$Mods.SpiritMod.Autoswing}"
			Tooltip: Habilita una línea adicional en las descripciones emergentes de las armas que se muestra si un objeto se reutiliza automáticamente/se balancea automáticamente.
		}

		QuickSell: {
			Label: "{$Mods.SpiritMod.Quicksell}"
			Tooltip: Habilita la función de venta rápida, que permite vender fácilmente todos los artículos no deseados a los NPC
		}

		AmbientSounds: {
			Label: "{$Mods.SpiritMod.AmbientSounds}"
			Tooltip: Habilita efectos de sonido ambiental para algunos biomas
		}

		LeafFall: {
			Label: "{$Mods.SpiritMod.LeafFallAmbience}"
			Tooltip:
				'''
				Permite el ambiente de hojas que caen durante las noches tranquilas o mientras se está en la zarza
				Desactívalo para evitar interacciones extrañas mientras juegas a Terraria Overhaul
				'''
		}

		QuestBookLocation: {
			Label: "{$Mods.SpiritMod.QuestButton}"
			Tooltip: Cambia la ubicación del botón del libro de misiones en tu inventario
		}

		QuestBookSwitching: {
			Label: "{$Mods.SpiritMod.QuestBookSwitching}"
			Tooltip: Cambia de la pestaña actual a la pestaña Activa o Completa cuando se activa o completa una misión.
		}

		ShowNPCQuestNotice: {
			Label: "{$Mods.SpiritMod.QuestIcons}"
			Tooltip: Habilita la visualización de signos de exclamación de misión cuando un PNJ de la ciudad tiene una nueva misión.
		}

		DoubleHideoutGeneration: {
			Label: "{$Mods.SpiritMod.ArcaneHideoutGen}"
			Tooltip:
				'''
				Permite la generación tanto del Escondite de Bandidos como de la Torre Arcana.
				Solo aparece uno por mundo de forma predeterminada
				Recomendado solo para mundos grandes
				'''
		}

		OceanShape: {
			Label: "{$Mods.SpiritMod.OceanShape}"
			Tooltip:
				'''
				Modifica la generación Oceánica de ciertas maneras.
				Por defecto usa una generación del tipo Piecewise_V
				Se recomienda la generación Piecewise_V para partidas con el mod Spirit
				'''
		}

		VentCritters: {
			Label: "{$Mods.SpiritMod.OceanVents}"
			Tooltip:
				'''
				Permite la reaparición de numerosos bichos alrededor de los respiraderos hidrotermales
				Estos bichos no interfieren con las tasas de aparición regulares de los enemigos
				Sin embargo, contribuyen al límite máximo de NPC
				'''
		}

		SurfaceWaterTransparency: {
			Label: "{$Mods.SpiritMod.OceanWater}"
			Tooltip:
				'''
				Permite que el agua del océano sea transparente cuando está encendido
				Esto no afecta a ningún otro bioma
				'''
		}

		EnemyFishing: {
			Label: "{$Mods.SpiritMod.WaterEnemies}"
			Tooltip: Permite encuentros con enemigos mientras se pesca
		}

		AuroraEnabled: {
			Label: "[i:SpiritMod/MoonStone]  Visuales: Aurora activada"
			Tooltip: Activa o desactiva los efectos visuales de la aurora. Esto no evita que aparezcan efectos o enemigos basados en la aurora
		}

		EnableSepulchres: {
			Label: "[i:SpiritMod/CursedArmorItem]  Generación del mundo: Habilitar sepulcros oscuros"
			Tooltip: Activa o desactiva la generación de los sepulcros oscuros que aparecen bajo tierra. Resulta útil desactivarlo si se producen conflictos de generación con otros mods
		}

		ForceClassicZiggurat: {
			Label: "[i:607]  Forzar Zigurat clásico"
			Tooltip: Permite que aparezca el Zigurat de Spirit Classic incluso si Spirit Reforged está activo. Ten en cuenta que el Zigurat clásico podría solaparse con otras estructuras.
		}
	}

	QuestInvLocation: {
		Tooltip: ""

		Minimap: {
			Label: Minimapa
			Tooltip: ""
		}

		Trashcan: {
			Label: Cubo de basura
			Tooltip: ""
		}

		FarLeft: {
			Label: Extremo izquierdo
			Tooltip: ""
		}
	}

	OceanShape: {
		Tooltip: ""

		Default: {
			Label: Predeterminado
			Tooltip: Generación oceánica predeterminada de Terraria (vanilla). Desactiva la generación de Spirit Classic.
		}

		SlantedSine: {
			Label: Seno Inclinado
			Tooltip: Pendiente ajustada que utiliza una onda sinusoidal diagonal para la generación.
		}

		Piecewise: {
			Label: Piecewise
			Tooltip: Generación por tramos que combina varias pendientes. Generación original por tramos, aunque algo irregular.
		}

		Piecewise_M: {
			Label: Piecewise_ M
			Tooltip: Generación por tramos modificada, ligeramente mejorada.
		}

		Piecewise_V: {
			Label: Piecewise_ V
			Tooltip: Generación por tramos final, la generación oceánica prevista para Spirit.
		}
	}

	SpiritMusicConfig: {
		DisplayName: Configuración de Música

		BlizzardMusic: {
			Label: "{$Mods.SpiritMod.BlizzardMusic}"
			Tooltip: Agrega una pista única para las ventiscas
		}

		SnowNightMusic: {
			Label: "{$Mods.SpiritMod.SnowNightMusic}"
			Tooltip: Agrega una pista única para el bioma de Nieve durante la noche
		}

		DesertNightMusic: {
			Label: "{$Mods.SpiritMod.DesertNightMusic}"
			Tooltip: Agrega una pista única para el bioma del Desierto durante la noche
		}

		HallowNightMusic: {
			Label: "{$Mods.SpiritMod.HallowNightMusic}"
			Tooltip: Agrega una pista única para El Sagrado durante la noche
		}

		CorruptNightMusic: {
			Label: "{$Mods.SpiritMod.CorruptNightMusic}"
			Tooltip: Agrega una pista única para la Corrupción durante la noche
		}

		CrimsonNightMusic: {
			Label: "{$Mods.SpiritMod.CrimsonNightMusic}"
			Tooltip: Agrega una pista única para el Carmesí durante la noche
		}

		GraniteMusic: {
			Label: "{$Mods.SpiritMod.GraniteMusic}"
			Tooltip: Agrega una pista única para el bioma de Granito
		}

		MarbleMusic: {
			Label: "{$Mods.SpiritMod.MarbleMusic}"
			Tooltip: Agrega una pista única para el bioma de Mármol
		}

		UnderwaterMusic: {
			Label: "{$Mods.SpiritMod.OceanDepthsMusic}"
			Tooltip: Habilita música única para el Océano al estar bajo el agua profunda
		}

		SpiderCaveMusic: {
			Label: "{$Mods.SpiritMod.SpiderMusic}"
			Tooltip: Agrega una pista única para las cavernas de Arañas
		}

		MeteorMusic: {
			Label: "{$Mods.SpiritMod.MeteorMusic}"
			Tooltip: Agrega una pista única para el bioma de Meteorito
		}

		FrostLegionMusic: {
			Label: "{$Mods.SpiritMod.FrostLegionMusic}"
			Tooltip: Agrega una pista única para la Legión Helada
		}

		SkeletronPrimeMusic: {
			Label: "{$Mods.SpiritMod.SkeletonPrimeMusic}"
			Tooltip: Agrega una pista única de jefe para Skeletron Prime.
		}

		AuroraMusic: {
			Label: "{$Mods.SpiritMod.AuroraMusic}"
			Tooltip: Habilita música única para las Auroras
		}

		LuminousMusic: {
			Label: "{$Mods.SpiritMod.LuminousMusic}"
			Tooltip: Habilita música única para los Océanos Luminosos
		}

		CalmNightMusic: {
			Label: "{$Mods.SpiritMod.CalmNightMusic}"
			Tooltip: Habilita música única para las Noches Tranquilas
		}

		NeonBiomeMusic: {
			Label: "{$Mods.SpiritMod.HyperspaceMusic}"
			Tooltip: Habilita dos pistas únicas al estar en el bioma Hiperspacio
		}

		AshfallMusic: {
			Label: "{$Mods.SpiritMod.AshfallMusic}"
			Tooltip: Habilita una pista única para el clima de Ceniza en el Inframundo
		}

		VictoryDayMusic: {
			Label: "{$Mods.SpiritMod.VictoryDayMusic}"
			Tooltip: Habilita una pista única para el día después del evento de la Noche de los Faroles
		}
	}
}

Events: {
	BlueMoon: {
		BossChecklistIntegration.Condition: Usa un [i:SpiritMod/BlueMoonSpawn] por la noche.
		OnStart: La Luna Mística está saliendo...
		IsDay: La luna no es poderosa a la luz del día.
		IsCalmNight: La noche es demasiado tranquila.
	}

	JellyDeluge: {
		BossChecklistIntegration.Condition: Ocurre naturalmente en la superficie después de que cualquier jefe haya sido derrotado. También puede ser invocado mediante el uso de un [i:SpiritMod/DistressJellyItem], encontrado en los biomas de asteroides y capturado usando una red de insectos. Ocurre con menos frecuencia después de que el Mago de gelatina lunar ha sido derrotado.
		OnStart: ¡Unas extrañas medusas están lloviendo del cielo!
	}

	LuminousOcean.OnStart: Un resplandor ilumina el océano…

	TheTide: {
		BossChecklistIntegration.Condition: Usa un [i:SpiritMod/BlackPearl] en el océano en cualquier momento.
		OnEnd: ¡La marea ha disminuido!
		NotOcean: La marea solo sube en la calma del mar.
		AlreadyActive: ¡La marea ya ha subido!
		Wave: "Oleada {0} : "
	}
}

BossChecklistIntegration: {
	JellyDeluge.EntryName: Diluvio de gelatina
	TheTide.EntryName: La marea
	MysticMoon.EntryName: Luna Mística
}

MapObject: {
	SpiritPylon: Pilón espiritual
	BriarPylon: Pilón de la zarza
	AsteroidPylon: Pilón de asteroides
}

Condition: {
	InBriar: Mods.SpiritMod.Condition.InBriar
	InAsteroids: Mods.SpiritMod.Condition.InAsteroids
	InSpirit: Mods.SpiritMod.Condition.InSpirit
	FirstDown: Solo en la primera derrota
}

GameTips: {
	SpiritGameTip0: ¡La jalea lunar es una gran fuente de curación!
	SpiritGameTip1: ¡El supervisor no va a volver!
	SpiritGameTip2: Puedes encontrar al aventurero en la zarza subterránea en cualquier momento.
	SpiritGameTip3: Los santuarios místicos ofrecen muchos beneficios, ¡o amenazas!
	SpiritGameTip4: El Jem tiene un poder incalculable. ¿Tienes lo que se necesita?
	SpiritGameTip5: Derrota al Starplate Voyager para obtener Astralita, un poderoso metal espacial.
	SpiritGameTip6: El océano está lleno de muchas sorpresas. ¡Compruébalo alguna vez!
	SpiritGameTip7: Los garrotes son armas de corto alcance muy agradables, especialmente si necesitas mantener a muchos enemigos alejados de ti.
	SpiritGameTip8: Los sepulcros subterráneos son peligrosos, pero valen la pena.
	SpiritGameTip9: Las misiones son una forma fácil de obtener un montón de recompensas: ¡habla con el aventurero para obtener el libro!
}

AvianIslandSigns: {
	0: (El texto es ilegible)
	1: Complejo flotante — Lo único que… (marcas de arañazos)
	2: ¿Supervisor visto a lo lejos? Más en 5
	3: ¿Un avivamiento? ¡Más probable que un gracias!
	4: ¡Encuentra más… (marcas de arañazos) por solo 50 g!
}
