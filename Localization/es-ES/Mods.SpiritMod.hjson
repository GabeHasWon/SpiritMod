MiscUI: {
	AutoSell: Clic para vender tus objetos rápidamente
	SellLock:
		'''
		Activa esto para bloquear la función de venta rápida
		No podrás usar la venta rápida mientras esto esté activado
		'''
	SellWeapons: Activa esto para desactivar la venta de armas
	SellNoValue: Activa esto para vender objetos 'sin valor' con la venta rápida
	Autofire: Disparo Automático
	Autoswing: Auto-Balanceo
}

Keybinds: {
	"SpiritMod:QuestBookToggle.DisplayName": Spirit Mod: Alternar Libro de Misiones
	"SpiritMod:QuestHUDToggle.DisplayName": Spirit Mod: Alternar Interfaz de Misiones
}

Configs: {
	SpiritClientConfig: {
		DisplayName: Configuración del Cliente

		ScreenShake: {
			Label: "{$Mods.SpiritMod.Screenshake}"
			Tooltip:
				'''
				Modifica la intensidad del temblor de pantalla aplicado por el contenido del mod
				Establécelo en 0 para desactivarlo por completo
				'''
		}

		DistortionConfig: {
			Label: "{$Mods.SpiritMod.Distortion}"
			Tooltip: Activa la distorsión de pantalla mientras estás en el Bioma del Espiritu o al luchar contra el Viajero Estelar
		}

		ForegroundParticles: {
			Label: "{$Mods.SpiritMod.Particles}"
			Tooltip: Activa partículas adicionales en primer plano bajo ciertas condiciones
		}

		AutoReuse: {
			Label: "{$Mods.SpiritMod.Autoswing}"
			Tooltip: Activa una línea adicional en las descripciones emergentes de las armas que muestra si un objeto es de auto-balanceo/disparo automático
		}

		QuickSell: {
			Label: "{$Mods.SpiritMod.Quicksell}"
			Tooltip: Activa la función de venta rápida, que permite vender fácilmente todos los objetos no deseados a los PNJ
		}

		AmbientSounds: {
			Label: "{$Mods.SpiritMod.AmbientSounds}"
			Tooltip: Activa efectos de sonido ambiental para algunos biomas
		}

		LeafFall: {
			Label: "{$Mods.SpiritMod.LeafFallAmbience}"
			Tooltip:
				'''
				Activa la ambientación de hojas cayendo durante las Noches Tranquilas o mientras estás en el Zarzal
				Desactiva esto para evitar interacciones extrañas al jugar con Terraria Overhaul
				'''
		}

		QuestBookLocation: {
			Label: "{$Mods.SpiritMod.QuestButton}"
			Tooltip: Cambia dónde aparece el botón del libro de misiones en tu inventario
		}

		QuestBookSwitching: {
			Label: "{$Mods.SpiritMod.QuestBookSwitching}"
			Tooltip: Cambia de la pestaña actual a la pestaña Activas o Completadas cuando una misión se activa o se completa
		}

		ShowNPCQuestNotice: {
			Label: "{$Mods.SpiritMod.QuestIcons}"
			Tooltip: Activa la visualización de signos de exclamación de misiones cuando un PNJ del Pueblo tiene una nueva misión
		}

		DoubleHideoutGeneration: {
			Label: "{$Mods.SpiritMod.ArcaneHideoutGen}"
			Tooltip:
				'''
				Activa la generación de la Guarida de Bandidos y la Torre Arcana al mismo tiempo
				Por defecto solo se genera una por mundo
				Recomendado solo para mundos grandes
				'''
		}

		OceanShape: {
			Label: "{$Mods.SpiritMod.OceanShape}"
			Tooltip:
				'''
				Modifica la generación del Océano de ciertas maneras
				Por defecto es una generación Por Tramos_V
				Se recomienda la generación Por Tramos_V para partidas con Spirit
				'''
		}

		VentCritters: {
			Label: "{$Mods.SpiritMod.OceanVents}"
			Tooltip:
				'''
				Activa la aparición de numerosas criaturas alrededor de las Fuentes Hidrotermales
				Estas criaturas no interfieren con la tasa de aparición de enemigos normales
				Sin embargo, sí contribuyen al límite máximo de PNJ
				'''
		}

		SurfaceWaterTransparency: {
			Label: "{$Mods.SpiritMod.OceanWater}"
			Tooltip:
				'''
				Permite agua de océano transparente cuando está activado
				Esto no afecta a ningún otro bioma
				'''
		}

		EnemyFishing: {
			Label: "{$Mods.SpiritMod.WaterEnemies}"
			Tooltip: Activa encuentros con enemigos al pescar
		}

		AuroraEnabled: {
			Label: "[i:SpiritMod/MoonStone]  Visuales: Aurora Activada"
			Tooltip: Activa/desactiva los efectos visuales de la Aurora. Esto no evita que aparezcan efectos o enemigos basados en la Aurora
		}

		EnableSepulchres: {
			Label: "[i:SpiritMod/CursedArmorItem]  Generación de mundo: Activar Sepulcros Oscuros"
			Tooltip: Activa/desactiva las estructuras de Sepulcros Oscuros encontradas bajo tierra. Útil para desactivar si experimentas problemas de generación con otros mods
		}

		ForceClassicZiggurat: {
			Label: "[i:607]  Forzar Zigurat Clásico"
			Tooltip: Permite que el Zigurat de Spirit Classic aparezca incluso si Spirit Reforged está activado. Ten en cuenta que el Zigurat Clásico puede solaparse con otras estructuras.
		}
	}

	QuestInvLocation: {
		Tooltip: ""

		Minimap: {
			Label: Minimapa
			Tooltip: ""
		}

		Trashcan: {
			Label: Papelera
			Tooltip: ""
		}

		FarLeft: {
			Label: Extremo Izquierdo
			Tooltip: ""
		}
	}

	OceanShape: {
		Tooltip: ""

		Default: {
			Label: Por Defecto
			Tooltip: Generación de océano por defecto de Vanilla. Desactiva la generación de Spirit Classic.
		}

		SlantedSine: {
			Label: Seno Inclinado
			Tooltip: Pendiente ajustada que utiliza una onda senoidal diagonal para la generación.
		}

		Piecewise: {
			Label: Por Tramos
			Tooltip: Generación por tramos combinando algunas pendientes. Generación por tramos original, pero un poco tosca.
		}

		Piecewise_M: {
			Label: Por Tramos_ M
			Tooltip: Generación por tramos modificada, ligeramente mejorada.
		}

		Piecewise_V: {
			Label: Por Tramos_ V
			Tooltip: Generación por tramos final, la generación de océano prevista para Spirit.
		}
	}

	SpiritMusicConfig: {
		DisplayName: Configuración de Música

		BlizzardMusic: {
			Label: "{$Mods.SpiritMod.BlizzardMusic}"
			Tooltip: Añade una pista única para las Ventiscas
		}

		SnowNightMusic: {
			Label: "{$Mods.SpiritMod.SnowNightMusic}"
			Tooltip: Añade una pista única para el bioma de Nieve por la noche
		}

		DesertNightMusic: {
			Label: "{$Mods.SpiritMod.DesertNightMusic}"
			Tooltip: Añade una pista única para el bioma del Desierto por la noche
		}

		HallowNightMusic: {
			Label: "{$Mods.SpiritMod.HallowNightMusic}"
			Tooltip: Añade una pista única para la Bendición por la noche
		}

		CorruptNightMusic: {
			Label: "{$Mods.SpiritMod.CorruptNightMusic}"
			Tooltip: Añade una pista única para la Corrupción por la noche
		}

		CrimsonNightMusic: {
			Label: "{$Mods.SpiritMod.CrimsonNightMusic}"
			Tooltip: Añade una pista única para el Carmesí por la noche
		}

		GraniteMusic: {
			Label: "{$Mods.SpiritMod.GraniteMusic}"
			Tooltip: Añade una pista única para el bioma de Granito
		}

		MarbleMusic: {
			Label: "{$Mods.SpiritMod.MarbleMusic}"
			Tooltip: Añade una pista única para el bioma de Mármol
		}

		UnderwaterMusic: {
			Label: "{$Mods.SpiritMod.OceanDepthsMusic}"
			Tooltip: Activa música única para el Océano mientras estés bajo el agua a gran profundidad
		}

		SpiderCaveMusic: {
			Label: "{$Mods.SpiritMod.SpiderMusic}"
			Tooltip: Añade una pista única para las Cuevas de Arañas
		}

		MeteorMusic: {
			Label: "{$Mods.SpiritMod.MeteorMusic}"
			Tooltip: Añade una pista única para el bioma de Meteorito
		}

		FrostLegionMusic: {
			Label: "{$Mods.SpiritMod.FrostLegionMusic}"
			Tooltip: Añade una pista única para la Legión de Escarcha
		}

		SkeletronPrimeMusic: {
			Label: "{$Mods.SpiritMod.SkeletonPrimeMusic}"
			Tooltip: Añade una banda sonora única para el jefe Esqueletrón Mayor
		}

		AuroraMusic: {
			Label: "{$Mods.SpiritMod.AuroraMusic}"
			Tooltip: Activa música única para las Auroras
		}

		LuminousMusic: {
			Label: "{$Mods.SpiritMod.LuminousMusic}"
			Tooltip: Activa música única para los Océanos Luminosos
		}

		CalmNightMusic: {
			Label: "{$Mods.SpiritMod.CalmNightMusic}"
			Tooltip: Activa música única para las Noches Tranquilas
		}

		NeonBiomeMusic: {
			Label: "{$Mods.SpiritMod.HyperspaceMusic}"
			Tooltip: Activa dos pistas únicas mientras estés en el Hiperespacio
		}

		AshfallMusic: {
			Label: "{$Mods.SpiritMod.AshfallMusic}"
			Tooltip: Activa una pista única para el clima de Lluvia de Ceniza en el Inframundo
		}

		VictoryDayMusic: {
			Label: "{$Mods.SpiritMod.VictoryDayMusic}"
			Tooltip: Activa una pista única para el día posterior al evento de la Noche de las Linternas
		}
	}
}

Events: {
	BlueMoon: {
		BossChecklistIntegration.Condition: Usa un [i:SpiritMod/BlueMoonSpawn] por la noche.
		OnStart: La Luna Mística está saliendo...
		IsDay: La luna no es poderosa a la luz del día.
		IsCalmNight: La noche está demasiado tranquila.
	}

	JellyDeluge: {
		BossChecklistIntegration.Condition: Ocurre de forma natural en la superficie tras derrotar a cualquier jefe. También se puede invocar usando una [i:SpiritMod/DistressJellyItem], encontrada en los biomas de Asteroides y capturada con una red para bichos. Ocurre con menor frecuencia tras derrotar al Mago Medusa Lunar.
		OnStart: ¡Están lloviendo medusas extrañas del cielo!
	}

	LuminousOcean.OnStart: Un resplandor florece sobre el océano...

	TheTide: {
		BossChecklistIntegration.Condition: Usa una [i:SpiritMod/BlackPearl] en el Océano en cualquier momento.
		OnEnd: ¡La Marea ha amainado!
		NotOcean: La Marea solo fluye junto a la calma del mar.
		AlreadyActive: ¡La Marea ya ha comenzado!
		Wave: "Oleada {0} : "
	}
}

BossChecklistIntegration: {
	JellyDeluge.EntryName: Diluvio de Medusas
	TheTide.EntryName: La Marea
	MysticMoon.EntryName: Luna Mística
}

MapObject: {
	SpiritPylon: Torre de Espiritu
	BriarPylon: Torre del Zarzal
	AsteroidPylon: Torre de Asteroides
}

Condition: {
	InBriar: Mods.SpiritMod.Condition.InBriar
	InAsteroids: Mods.SpiritMod.Condition.InAsteroids
	InSpirit: Mods.SpiritMod.Condition.InSpirit
	FirstDown: Solo en la primera derrota
}

GameTips: {
	SpiritGameTip0: ¡La medusa lunar es una excelente fuente de curación!
	SpiritGameTip1: ¡El Veedor no va a volver!
	SpiritGameTip2: Puedes encontrar al Aventurero en el Zarzal Subterráneo en cualquier momento.
	SpiritGameTip3: Los Santuarios Místicos ofrecen muchos beneficios... ¡o amenazas!
	SpiritGameTip4: La Gema alberga un poder inconmensurable. ¿Tienes lo necesario?
	SpiritGameTip5: Derrota al Viajero Estelar para obtener astralita, un poderoso metal espacial.
	SpiritGameTip6: El océano está lleno de sorpresas. ¡Pásate a echar un vistazo en algún momento!
	SpiritGameTip7: Los garrotes son armas de corto alcance muy útiles, especialmente si necesitas mantener a raya a muchos enemigos.
	SpiritGameTip8: Los Sepulcros en las profundidades subterráneas son peligrosos, pero valen mucho la pena.
	SpiritGameTip9: Las misiones son una forma fácil de conseguir un montón de recompensas: ¡habla con el Aventurero para obtener el libro!
}

AvianIslandSigns: {
	0: (el texto es ilegible)
	1: Complejo Flotante - El único (marcas de arañazos)
	2: ¿Veedor avistado en la distancia? Más información a las 5
	3: ¿Un resurgimiento? ¡Más probable de lo que crees!
	4: ¡Encuentra más (marcas de arañazos) y por solo 50 monedas de oro!
}
