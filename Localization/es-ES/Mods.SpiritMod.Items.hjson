		'''
}

KoiTotem: {
	DisplayName: Tótem Koi
	Tooltip:
		'''
		Aumenta el poder de pesca al equiparlo o colocarlo cerca
		El tótem a veces escupe el cebo utilizado para poder reutilizarlo

		'''
}

BismiteShield: {
	DisplayName: Rodela Nociva
	Tooltip:
		'''
		Recibir el impacto de un enemigo inflige heridas supurantes
