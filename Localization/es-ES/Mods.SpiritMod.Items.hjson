		'''
}

HighGravityBoots: {
	DisplayName: Botas de Alta Gravedad
	Tooltip:
		'''
		Normaliza la gravedad en el espacio
		Mantén ABAJO para aumentar la gravedad y el impulso vertical
		'''
}

IchorPendant: {
	DisplayName: Colgante de Ícor
	Tooltip:
		'''
		6% de daño cuerpo a cuerpo aumentado
		Los golpes cuerpo a cuerpo a veces infligen Ícor
		'''
}

IllusionistEye: {
	DisplayName: Ojo del Ilusionista
	Tooltip:
		'''
		Recibir daño fatal en su lugar te teletransporta de vuelta a casa
		Este efecto no funciona si hay un jefe cerca
