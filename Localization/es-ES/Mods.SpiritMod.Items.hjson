	DisplayName: Caja de Drones G-TEK
	Tooltip:
		'''
		Invoca 3 drones para que te ayuden
		Sostener un pico cambia los drones al modo de minería
		En el modo de minería, estos drones copiarán la potencia de tu pico y minarán contigo
		Estos drones no ocupan espacio de súbditos
		'''
}

GravityModulator: {
	DisplayName: Modulador de Gravedad
	Tooltip: Reduce la gravedad del jugador significativamente
}

HellEater: {
	DisplayName: Fauce Ígnea
	Tooltip:
		'''
		Los ataques mágicos pueden disparar salivazos ígneos que explotan al impactar a los enemigos
