		'''
}

BloodfireShield: {
	DisplayName: Escudo Sanguíneo
	Tooltip:
		'''
		Reduce la regeneración de vida a 0
		Aumenta el PV máximo en 40
		'''
}

ClatterboneShield: {
	DisplayName: Protector Ferviente
	Tooltip:
		'''
		Aumenta la defensa en 2 y reduce la velocidad de movimiento en un 3% por cada enemigo cercano
		Este efecto se acumula hasta cinco veces
		'Hay algo especial entre nosotros'
		'''
}

ExplorerTreads: {
	DisplayName: Calzado del Explorador
	Tooltip:
		'''
		+5% de velocidad de movimiento por cada 10% de vida restante que falte
