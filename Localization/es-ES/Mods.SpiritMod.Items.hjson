Glyph: {
	DisplayName: Glifo en Blanco
	Tooltip: "'El Encantador probablemente podría usar esto'"
	Gain: El arma encantada obtendrá: [c/{0}:{1}]
	Target: Solo se puede aplicar a armas
	RightClick: Sostén este glifo y haz clic derecho sobre el arma que quieras encantar
	Remove: Sostén este glifo y haz clic derecho sobre el objeto cuyo glifo quieras eliminar
	PriceText: "{0} {^0:glifo;glifos}"
}

NullGlyph: {
	DisplayName: Glifo Nulo
	Tooltip: Se puede usar para borrar un glifo de un objeto
	Addendum: Nulo
	Effect: Nulo
}

PhaseGlyph: {
	DisplayName: Glifo de Fase
	Tooltip:
		'''
		El daño del arma aumenta cuanto más rápido te mueves, pero disminuye al moverte despacio
		Los golpes consecutivos otorgan un breve impulso de velocidad
		'''
	Addendum:
		'''
		El daño del arma aumenta cuanto más rápido te mueves, pero disminuye al moverte despacio
		Los golpes consecutivos otorgan un breve impulso de velocidad
		'''
	Effect: Temporal

	Gendered: {
		Fem: ""
		Neutral: ""
		Plural: ""
	}
}

RadiantGlyph: {
