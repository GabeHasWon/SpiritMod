}

FallenAngel: {
	DisplayName: Sello Angélico
	Tooltip:
		'''
		Los ataques mágicos pueden disparar una chispa angélica
		Esta chispa inflige más daño cuanto menos maná le quede al jugador
		'''
}

FeralConcoction: {
	DisplayName: Brebaje de Inmunidad
	Tooltip: Inmunidad a Mordisco Feroz
}

Flying_Fish_Fin: {
	DisplayName: Aleta de Pez Volador
