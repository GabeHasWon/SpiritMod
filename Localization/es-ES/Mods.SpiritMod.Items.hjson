AceOfClubs: {
	DisplayName: As de Tréboles
	Tooltip: Los golpes críticos hacen que los enemigos suelten dinero
}

AceOfDiamonds: {
	DisplayName: As de Diamantes
	Tooltip:
		'''
		Los golpes críticos tienen la probabilidad de soltar Ases de Diamantes
		Los Ases de Diamantes otorgan un 20% de daño aumentado durante 5 segundos al recogerlos
		'''
}

AceOfHearts: {
	DisplayName: As de Corazones
	Tooltip: Los golpes críticos tienen la probabilidad de soltar corazones
}

AceOfSpades: {
	DisplayName: As de Picas
	Tooltip: Los golpes críticos infligen daño adicional.
}

DiamondAce: {
	DisplayName: As de Diamantes
	Tooltip: No deberías ver esto
}

FourOfAKind: {
	DisplayName: Poker de Ases
	Tooltip:
		'''
		Los golpes críticos infligen daño adicional y hacen que suelten dinero
		Los golpes críticos tienen la probabilidad de soltar un As de Diamantes o un corazón
		'''
}

AssassinMagazine: {
	DisplayName: Cargador del Asesino
	Tooltip:
		'''
		Pulsa dos veces {0} mientras sostienes un arma a distancia para cambiar de tipo de munición
		Funciona desde el inventario
		'''
}

Bauble: {
	DisplayName: Adorno Invernal
	Tooltip:
		'''
		Aumenta las capacidades defensivas y de movimiento al tener menos de la mitad de la vida
		Al bajar de la mitad de la vida, crea un escudo que anula proyectiles durante 6 segundos
		1 minuto de enfriamiento
		'''
}

BowSummonItem: {
	DisplayName: Arco Afligido
	Tooltip:
		'''
		Invoca un arco poseído para que luche por ti
		Utiliza la primera flecha de tu inventario
		Si no tienes flechas, dispara Flechas de bufón más débiles de forma infinita
		El arco no ocupa espacio de súbditos
		'''
}

ChaosCrystal: {
	DisplayName: Cristal del Caos
	Tooltip: Recibir daño tiene la probabilidad de teletransportarte a un lugar cercano
}

CimmerianScepter: {
	DisplayName: Cetro Cimerio
	Tooltip:
		'''
		Invoca un cetro mágico para que luche por ti
		El cetro realiza multitud de ataques contra los enemigos
		Este cetro no ocupa espacio de súbditos
		'''
}

CleftHorn: {
	DisplayName: Cuerno Hendido
	Tooltip:
		'''
		Aumenta la penetración de armadura en 3
		Los ataques cuerpo a cuerpo a veces golpean a los enemigos dos veces
		'''
}

CultistScarf: {
	DisplayName: Bufanda de Tejeduría Ancestral
	Tooltip:
		'''
		20% de consumo de maná reducido al tener menos de la mitad de la vida
		Aumenta el maná máximo en 120 al tener más de la mitad de la vida
		9% de probabilidad de golpe crítico mágico aumentada
		Los ataques mágicos a veces liberan proyectiles de magia antigua poderosa que rebotan en las paredes
		'''
}

CursedPendant: {
	DisplayName: Colgante Maldito
	Tooltip:
		'''
		6% de daño cuerpo a cuerpo aumentado
		Las armas tienen un 15% de probabilidad de infligir Llamas malditas
		'''
}

DarkfeatherVisage: {
	DisplayName: Rostro de Pluma Oscura
	Tooltip:
		'''
		Aumenta el daño mágico y de invocación en un 7%
		Otorga una bonificación al llevarlo con una túnica mágica o un abrigo de piel
		'''
}

Dartboard: {
	DisplayName: Diana
	Tooltip:
		'''
		13% de daño reducido
		15% de probabilidad de ataque crítico aumentada
		'Justo en el blanco'
		'''
}

DesertSlab: {
	DisplayName: Losa Ancestral
