AceOfClubs: {
	DisplayName: As de tréboles
	Tooltip: Los golpes críticos hacen que los enemigos suelten dinero
}

AceOfDiamonds: {
	DisplayName: As de diamantes
	Tooltip:
		'''
		Los golpes críticos pueden hacer caer Ases de Diamante.
		Los ases de diamante te dan un 20% más de daño durante 5 segundos al recoger
		'''
}

AceOfHearts: {
	DisplayName: As de corazones
	Tooltip: Los golpes críticos tienen una probabilidad de soltar corazones
}

AceOfSpades: {
	DisplayName: As de picas
	Tooltip: Los golpes críticos infligen daño extra.
}

DiamondAce: {
	DisplayName: As de diamante
	Tooltip: No deberías ver esto
}

FourOfAKind: {
	DisplayName: Cuatro iguales
	Tooltip:
		'''
		Los golpes críticos infligen daño extra y dejan dinero
		Los golpes críticos tienen la posibilidad de soltar un as de diamantes o un corazón
		'''
}

AssassinMagazine: {
	DisplayName: Revista del Asesino
	Tooltip:
		'''
		Toca dos veces {0} mientras sostienes un arma a distancia para cambiar de tipo de munición.
		Funciona mientras está en el inventario
		'''
}

Bauble: {
	DisplayName: Adorno de invierno
	Tooltip:
		'''
		Las habilidades defensivas y de movimiento aumentan cuando se está por debajo de la mitad de la salud
		Al caer por debajo de la mitad de la salud, se crea un escudo que anula los proyectiles durante 6 segundos.
		1 minuto de enfriamiento
		'''
}

BowSummonItem: {
	DisplayName: Arco iris
	Tooltip:
		'''
		Invoca un arco poseído para que luche por ti
		Utiliza la primera flecha de tu inventario
		Si no tienes flechas, dispara flechas de bufón más débiles infinitamente
		El arco no ocupa ninguna ranura de súbdito
		'''
}

ChaosCrystal: {
	DisplayName: Cristal del Caos
	Tooltip: Ser golpeado tiene una probabilidad de teletransportarte a algún lugar cercano
}

CimmerianScepter: {
	DisplayName: Cetro cimerio
	Tooltip:
		'''
		Invoca un cetro mágico para que luche por ti
		El cetro utiliza una multitud de ataques contra los enemigos
		Este cetro no ocupa ranuras de súbditos
		'''
}

CleftHorn: {
	DisplayName: Cuerno hendido
	Tooltip:
		'''
		Aumenta la penetración de armadura en un 3
		En ocasiones, los ataques cuerpo a cuerpo golpean dos veces a los enemigos
		'''
}

CultistScarf: {
	DisplayName: Bufanda Elderweave
	Tooltip:
		'''
		20% de uso de maná reducido cuando se está por debajo de la mitad de la salud
		Aumenta el maná máximo en 120 cuando se supera la mitad de la salud
		Aumento del 9% de la probabilidad de golpe crítico mágico
		Los ataques mágicos liberan ocasionalmente rayos de poderosa Magia Antigua que rebotan en las paredes.
		'''
}

CursedPendant: {
	DisplayName: Colgante maldito
	Tooltip:
		'''
		6% más de daño cuerpo a cuerpo
		Las armas tienen un 15% de probabilidad de infligir Infierno maldito.
		'''
}

DarkfeatherVisage: {
	DisplayName: Rostro de Pluma Oscura
	Tooltip:
		'''
		Aumenta la magia y el daño de invocación en un 7%
		Otorga una bonificación cuando se usa con una túnica mágica o un abrigo de piel.
		'''
}

Dartboard: {
	DisplayName: Tablero de dardos
	Tooltip:
		'''
		Daño reducido un 13%
		Probabilidad de golpe crítico aumentada un 15%
		'Justo en la marca'
		'''
}

DesertSlab: {
	DisplayName: Losa antigua
	Tooltip: Proporciona inmunidad a la desventaja 'Viento poderoso' durante las tormentas de arena.
}

ElectricGuitar: {
	DisplayName: Guitarra eléctrica
	Tooltip: Los enemigos cercanos y los enemigos golpeados por ataques pueden ser alcanzados por una cadena de relámpagos
}

FallenAngel: {
	DisplayName: Sello angélico
	Tooltip:
		'''
		Los ataques mágicos pueden disparar una chispa angelical
		Esta chispa inflige más daño cuanto menos maná le quede al jugador
		'''
}

FeralConcoction: {
	DisplayName: Brebaje de inmunidad
	Tooltip: Inmunidad a la mordedura salvaje
}

Flying_Fish_Fin: {
	DisplayName: Aleta de pez volador
	Tooltip: Aumenta la altura de salto y la velocidad de descenso
}

ForbiddenKnowledgeTome: {
	DisplayName: Tomo del Conocimiento Prohibido
	Tooltip: Al matar enemigos, se liberan cráneos espectrales rastreadores
}

FrostGiantBelt: {
	DisplayName: Cinturón de Gigantes de Escarcha
	Tooltip:
		'''
		50% de resistencia al retroceso mientras se carga un palo
		Cargar un palo aumenta gradualmente la defensa
		'''
}

GoldenApple: {
	DisplayName: Manzana dorada
	Tooltip: Aumenta la defensa a medida que disminuye la salud
}

GoldShield: {
	DisplayName: Escudo dorado
	Tooltip:
		'''
		Proporciona inmunidad al retroceso
		A medida que la salud disminuye, la defensa aumenta
		'''
}

GranitechDroneBox: {
	DisplayName: Caja de dron G-TEK
	Tooltip:
		'''
		Invoca 3 drones para que te ayuden
		Sostener un pico cambia los drones al modo de minería
		En el modo de minería, estos drones copiarán el poder de tu pico y minarán contigo
		Estos drones no ocupan espacio de súbditos
		'''
}

GravityModulator: {
	DisplayName: Modulador de gravedad
	Tooltip: Reduce significativamente la gravedad del jugador.
}

HellEater: {
	DisplayName: Fauces ardientes
	Tooltip:
		'''
		Los ataques mágicos pueden disparar escupitajos de fuego que explotan al golpear a los enemigos
		Daño mágico aumentado un 7%
		'''
}

HighGravityBoots: {
	DisplayName: Botas High-Grav
	Tooltip:
		'''
		Normaliza la gravedad en el espacio
		Mantenga presionado ABAJO para aumentar la gravedad y el impulso vertical
		'''
}

IchorPendant: {
	DisplayName: Colgante Icor
	Tooltip:
		'''
		Daño cuerpo a cuerpo aumentado un 6%
		Los golpes cuerpo a cuerpo ocasionalmente infligen icor
		'''
}

IllusionistEye: {
	DisplayName: Ojo del ilusionista
	Tooltip:
		'''
		Recibir daño fatal te teletransporta de regreso a casa
		Este efecto no funciona si hay un jefe cerca
		10 minutos de enfriamiento
		'Un ilusionista sin hogar es simplemente un espectro'
		'''
}

KoiTotem: {
	DisplayName: Tótem Koi
	Tooltip:
		'''
		Aumenta la habilidad de pesca cuando se usa o cuando se coloca cerca
		Totem ocasionalmente escupe el cebo que se usó para la reutilización

		'''
}

BismiteShield: {
	DisplayName: Targe nocivo
	Tooltip:
		'''
		Ser golpeado por un enemigo inflige heridas supurantes
		Aumenta la defensa en 2 por cada enemigo afectado cerca del jugador.
		Este efecto se acumula hasta cinco veces
		'''
}

BloodfireShield: {
	DisplayName: Scutum sanguíneo
	Tooltip:
		'''
		Reduce la regeneración de vida a 0
		Aumenta los PS máximos en 40
		'''
}

ClatterboneShield: {
	DisplayName: Ferviente protector
	Tooltip:
		'''
		Aumenta la defensa en 2 y reduce la velocidad de movimiento en un 3% por cada enemigo cercano.
		Este efecto se acumula hasta cinco veces
		'Hay algo especial entre nosotros'
		'''
}

ExplorerTreads: {
	DisplayName: Bandas del Explorador
	Tooltip:
		'''
		+5 % de velocidad de movimiento por cada 10 % de vida que falte
		50% de probabilidad de evitar trampas y peligros
		'Hace que explorar los templos sea como un paseo por el parque'
		'''
}

FrigidGloves: {
	DisplayName: Envolturas gélidas
	Tooltip:
		'''
		Los golpes críticos cuerpo a cuerpo infligen Quemadura de Escarcha
		Otorga un 4% más de velocidad de ataque por cada enemigo cercano.
		Este efecto se acumula hasta cinco veces
		'''
}

LeatherBoots: {
	DisplayName: Zancudos de cuero
	Tooltip: Aumenta ligeramente la velocidad de movimiento y la aceleración.
}

LeatherGlove: {
	DisplayName: Envolturas de cuero
	Tooltip: Aumenta la velocidad cuerpo a cuerpo en un 6%
}

LeatherShield: {
	DisplayName: Salvaguarda de cuero
	Tooltip: Aumenta la vida máxima en 10
}

Strikeshield: {
	DisplayName: Escudo de ataque
	Tooltip:
		'''
		Los enemigos son golpeados cuando te golpean a ti
		Los enemigos golpeados son el objetivo de los súbditos y reciben 3 de daño de etiqueta de invocación
		5 segundos de duración
		'''
}

TechBoots: {
	DisplayName: Botas Técnicas
	Tooltip:
		'''
		Aumenta ligeramente la velocidad de movimiento y la aceleración.
		Obtienes un gran aumento de velocidad por debajo de la mitad de la salud.
		'''
}

LongFuse: {
	DisplayName: Fusible largo
	Tooltip:
		'''
		Los explosivos arden más lentamente
		Funciona mientras está en el inventario
		'''
}

LumothLantern: {
	DisplayName: Linterna luminosa
	Tooltip:
		'''
		Proporciona luz brillante
		Funciona en la ranura de tocador, pero con menos eficacia
		'¡Aventúrate en las cavernas más profundas con una fuente de luz confiable!'
		'''
}

ArcaneNecklace: {
	DisplayName: Collar Arcano
	Tooltip:
		'''
		Aumenta el maná máximo en 20
		Los enemigos tienen un 20% de probabilidad de soltar una estrella de maná extra
		'''
}

ManaShield: {
	DisplayName: Escudo de maná
	Tooltip:
		'''
		Aumenta el maná máximo en 20
		Absorbe el 10% del daño infligido por los enemigos
		Este daño se convierte en una pérdida de maná
		La cantidad de maná perdido es igual a 4 veces el daño absorbido
		'''
}

SeraphimBulwark: {
	DisplayName: Baluarte de los serafines
	Tooltip:
		'''
		Aumenta el maná máximo en 40
		Absorbe el 10% del daño infligido por los enemigos
		Este daño se convierte en una pérdida de maná
		'''
}

MagnifyingGlass: {
	DisplayName: Lupa
	Tooltip:
		'''
		Probabilidad de golpe crítico aumentada un 4%
		Haga clic con el botón derecho para alejar cuando no esté sosteniendo un arma
		'''
}

MedusaShield: {
	DisplayName: Escudo de Medusa
	Tooltip:
		'''
		Proporciona inmunidad al retroceso y a la desventaja de colocón.
		A medida que la salud disminuye, la defensa aumenta
		'''
}

GildedScarab: {
	DisplayName: Escarabajo dorado
	Tooltip:
		'''
		Recibir un golpe proporciona un beneficio temporal a la defensa
		Este escudo proporciona más defensa en función del daño recibido
		'''
}

GrislyTongue: {
	DisplayName: Lengua espeluznante
	Tooltip:
		'''
		Recibir un golpe desaloja un trozo de carne que se puede recoger para recuperar una parte de la salud perdida
		Esta pastilla desaparece después de unos segundos
		'''
}

SlagMedallion: {
	DisplayName: Medallón de escoria
	Tooltip:
		'''
		Recibir un golpe otorga un beneficio de daño temporal
		Este beneficio aumenta con el daño recibido
		'''
}

GrislyBit: {
	DisplayName: Pedazo espeluznante
	Tooltip: No deberías ver esto
}

MetalBand: {
	DisplayName: Banda de metal
	Tooltip:
		'''
		Aumenta el alcance de recogida de minerales.
		'No, no puedes escuchar esto'
		'''
}

MimicRepellent: {
	DisplayName: Repelente Mímico
	Tooltip:
		'''
		Evita que los imitadores de cajas sean pescados
		'¡Mantén a raya a esos monstruos con tentáculos!'
		'''
}

Moonlight_Sack: {
	DisplayName: Saco de luz de luna
	CustomTooltip: Crea una cadena de relámpagos entre tú y tus esbirros que inflige daño
	Tooltip: ""
}

OpalFrogItem: {
	DisplayName: Rana de ópalo
	Tooltip:
		'''
		Velocidad de gancho aumentada un 15%
		Se desconecta automáticamente de los ganchos al llegar al extremo del gancho
		Deshabilitar la visibilidad de los accesorios para deshabilitar el desenganche automático
		'''
}

Rabbit_Foot: {
	DisplayName: Pata de conejo
	Tooltip:
		'''
		'¡Esto debe ser suerte!'
		Tienes un 1% de probabilidad de golpe crítico
		'''
}

Rangefinder: {
	DisplayName: Telémetro
	Tooltip:
		'''
		Las armas a distancia ahora están equipadas con una mira láser.
		Funciona mientras está en el inventario
		'''
}

RogueCrest: {
	DisplayName: Blasón del pícaro
	Tooltip:
		'''
		Invoca una espada oxidada para que luche por ti
		Esta espada no ocupa espacios de súbditos
		'''
}

RuneWizardScroll: {
	DisplayName: Pergamino del mago rúnico
	Tooltip:
		'''
		'Todos sabíamos que Skeletons sabía escribir.'
		Los ataques mágicos pueden infligir desventajas aleatorias y poderosas a los enemigos
		Los ataques mágicos pueden disparar un proyectil aleatorio
		'''
}

BloodWard: {
	DisplayName: Pabellón Sanguíneo
	Tooltip:
		'''
		Crea un aura rúnica debilitante
		Matar enemigos dentro de tu aura rúnica cura algo de vida
		'''
}

Sea_Snail_Poison: {
	DisplayName: Veneno de caracol marino
	Tooltip: Dejas un rastro de moco que envenena a los enemigos
}

ShadowSingeFang: {
	DisplayName: Colmillo chamuscado por las sombras
	Tooltip:
		'''
		Probabilidad de golpe crítico aumentada un 4%
		Probabilidad de golpe crítico aumentada un 4% por la noche o bajo tierra
		Atacar a enemigos que tienen menos de la mitad de su salud puede inducirlos con sombras, a costa de vidas
		'''
}

ShieldCore: {
	DisplayName: Núcleo de escudo interestelar
	Tooltip: Estás rodeado de escudos reflectantes
}

ShortFuse: {
	DisplayName: Mecha corta
	Tooltip:
		'''
		Los explosivos se queman más rápido
		Funciona mientras está en el inventario
		'''
}

ShurikenLauncher: {
	DisplayName: Guante de francotirador
	Tooltip:
		'''
		Aumenta el daño a distancia
		Los disparos consecutivos a esta distancia infligen más daño
		'''
}

SkarmoryWings: {
	DisplayName: Alas de álabe
	Tooltip:
		'''
		'Parece originarse de un organismo metálico de origen desconocido'
		Otorga huida y caída lenta
		Deja tras de sí un rastro de mercurio que se dirige a los enemigos
		'''
}

SpectreRing: {
	DisplayName: Anillo espectral
