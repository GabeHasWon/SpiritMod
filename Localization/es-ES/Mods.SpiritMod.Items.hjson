	DisplayName: Flora del Zarzal
	Tooltip:
		'''
		por el Investigador de Campo Laywatts
		Parece ser una página arrancada de un libro sobre el Zarzal
		Contiene un intrincado diagrama de la ecología del Zarzal
		'''
	ImagePath: SpiritMod/Localization/BooksUI/es-ES/TheBriar
}

Book_Soulbloom: {
	DisplayName: Notas Sobre la Flor de Alma
	Tooltip:
		'''
		por Lena Ashwood, Alquimista
		Detalla la anatomía y los usos de una hierba extremadamente rara
		'¿Dónde habrá encontrado esto?'
		'''
	ImagePath: SpiritMod/Localization/BooksUI/es-ES/SoulbloomPage
}

Book_SpiritArt: {
	DisplayName: Flora del Bioma Espíritu
	Tooltip:
		'''
		por el Investigador de Campo Laywatts
		Parece ser una página de notas sobre el desconocido Bioma Espíritu
		'Hay mucho que aprender de este misterioso lugar'
		'''
