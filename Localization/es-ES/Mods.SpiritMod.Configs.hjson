SpiritClientConfig: {
	DisplayName: Client Config

	ScreenShake: {
		Label: Sacudida de pantalla
		Tooltip:
			'''
			Modifica la intensidad del movimiento de pantalla aplicado por el contenido dentro del mod
			Establézcalo en 0 para deshabilitarlo por completo
			'''
	}

	DistortionConfig: {
		Label: Distorsión de pantalla
		Tooltip: Habilita la distorsión de la pantalla mientras estás en el Bioma Espiritual o cuando luchas contra el Starplate Voyager.
	}

	ForegroundParticles: {
		Label: Partículas en primer plano
		Tooltip: Habilita partículas adicionales en primer plano bajo ciertas condiciones
	}

	AutoReuse: {
		Label: Descripción de autouso
		Tooltip: Habilita una línea adicional en las descripciones emergentes de las armas que se muestra si un objeto se reutiliza automáticamente/se balancea automáticamente.
	}

	QuickSell: {
		Label: Función de venta rápida
		Tooltip: Habilita la función de venta rápida, que permite vender fácilmente todos los artículos no deseados a los NPC
	}

	AmbientSounds: {
		Label: Sonidos ambientales
		Tooltip: Habilita efectos de sonido ambiental para algunos biomas
	}

	LeafFall: {
		Label: Efectos de hojas cayendo
		Tooltip:
			'''
			Permite el ambiente de hojas que caen durante las noches tranquilas o mientras se está en la zarza
			Desactívalo para evitar interacciones extrañas mientras juegas a Terraria Overhaul
			'''
	}

	QuestBookLocation: {
		Label: Ubicación del botón del libro de misiones
		Tooltip: Cambia la ubicación del botón del libro de misiones en tu inventario
	}

	QuestBookSwitching: {
		Label: Cambio de pestañas del libro de misiones
		Tooltip: Cambia de la pestaña actual a la pestaña Activa o Completa cuando se activa o completa una misión.
	}

	ShowNPCQuestNotice: {
		Label: Iconos de misión para PNJ de ciudad
		Tooltip: Habilita la visualización de signos de exclamación de misión cuando un PNJ de la ciudad tiene una nueva misión.
	}

	DoubleHideoutGeneration: {
		Label: Generación de la Torre Arcana y del Refugio Bandido
		Tooltip:
			'''
			Permite la generación tanto del Escondite de Bandidos como de la Torre Arcana.
			Solo aparece uno por mundo de forma predeterminada
			Recomendado solo para mundos grandes
			'''
	}

	OceanShape: {
		Label: Forma de la generación del océano
		Tooltip:
			'''
			Modifica la generación Oceánica de ciertas maneras.
			Por defecto usa una generación del tipo Piecewise_V
			Se recomienda la generación Piecewise_V para partidas con el mod Spirit
			'''
	}

	VentCritters: {
		Label: Ecosistemas de respiraderos hidrotermales
		Tooltip:
			'''
			Permite la reaparición de numerosos bichos alrededor de los respiraderos hidrotermales
			Estos bichos no interfieren con las tasas de aparición regulares de los enemigos
			Sin embargo, contribuyen al límite máximo de NPC
			'''
	}

	SurfaceWaterTransparency: {
		Label: Transparencia del agua del océano
		Tooltip:
			'''
			Permite que el agua del océano sea transparente cuando está encendido
			Esto no afecta a ningún otro bioma
			'''
	}

	EnemyFishing: {
		Label: Encuentros de pesca
		Tooltip: Permite encuentros con enemigos mientras se pesca
	}

	AuroraEnabled: {
		Label: Aurora activada
		Tooltip: Activa o desactiva los efectos visuales de la aurora. Esto no evita que aparezcan efectos o enemigos basados en la aurora
	}

	EnableSepulchres: {
		Label: Habilitar sepulcros oscuros
		Tooltip: Activa o desactiva la generación de los sepulcros oscuros que aparecen bajo tierra. Resulta útil desactivarlo si se producen conflictos de generación con otros mods
	}

	ForceClassicZiggurat: {
		Label: Forzar Zigurat clásico
		Tooltip: Permite que aparezca el Zigurat de Spirit Classic incluso si Spirit Reforged está activo. Ten en cuenta que el Zigurat clásico podría solaparse con otras estructuras.
	}

	Headers: {
		// Visuals: "[i:SpiritMod/MoonStone] Visuals"
		// QoL: "[i:SpiritMod/PirateCrate] QoL"
		// Ambience: "[i:SpiritMod/GladeWreath] Ambience"
		// Quests: "[i:SpiritMod/MapScroll] Quests"
		// Generation: "[i:SpiritMod/BismiteCrystal] Generation"
		// Oceans: "[i:SpiritMod/BlackPearl] Oceans"
		// Fishing: "[i:SpiritMod/HornetfishQuest] Fishing"
	}
}

QuestInvLocation: {
	Tooltip: ""

	Minimap: {
		Label: Minimapa
		Tooltip: ""
	}

	Trashcan: {
		Label: Cubo de basura
		Tooltip: ""
	}

	FarLeft: {
		Label: Extremo izquierdo
		Tooltip: ""
	}
}

OceanShape: {
	Tooltip: ""

	Default: {
		Label: Predeterminado
		Tooltip: Generación oceánica predeterminada de Terraria (vanilla). Desactiva la generación de Spirit Classic.
	}

	SlantedSine: {
		Label: Seno Inclinado
		Tooltip: Pendiente ajustada que utiliza una onda sinusoidal diagonal para la generación.
	}

	Piecewise: {
		Label: Piecewise
		Tooltip: Generación por tramos que combina varias pendientes. Generación original por tramos, aunque algo irregular.
	}

	Piecewise_M: {
		Label: Piecewise_ M
		Tooltip: Generación por tramos modificada, ligeramente mejorada.
	}

	Piecewise_V: {
		Label: Piecewise_ V
		Tooltip: Generación por tramos final, la generación oceánica prevista para Spirit.
	}
}

