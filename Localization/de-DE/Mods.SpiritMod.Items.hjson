	DisplayName: G-TEK-Drohnenbox
	Tooltip:
		'''
		Beschwört 3 Drohnen, die dir helfen
		Eine Spitzhacke zu halten schaltet die Drohnen in den Abbau-Modus
		Im Abbau-Modus kopieren diese Drohnen deine Spitzhacken-Stärke und bauen mit dir ab
		Diese Drohnen belegen keine Dienerplätze
		'''
}

GravityModulator: {
	DisplayName: Schwerkraftmodulator
	Tooltip: Verringert die Schwerkraft des Spielers erheblich
}

HellEater: {
	DisplayName: Feuriges Maul
	Tooltip:
		'''
		Magieangriffe können feurige Spucke ausstoßen, die beim Treffer von Gegnern explodiert
		7% erhöhter Magieschaden
		'''
}

HighGravityBoots: {
	DisplayName: Hochschwerkraft-Stiefel
	Tooltip:
		'''
		Normalisiert die Schwerkraft im Weltraum
		Halte RUNTER, um Schwerkraft und vertikalen Schwung zu erhöhen
		'''
}

IchorPendant: {
	DisplayName: Ichor-Anhänger
	Tooltip:
		'''
		6% erhöhter Nahkampfschaden
		Nahkampftreffer verursachen gelegentlich Ichor
		'''
}

IllusionistEye: {
	DisplayName: Auge des Illusionisten
	Tooltip:
		'''
		Tödlicher Schaden teleportiert dich stattdessen nach Hause
		Dieser Effekt funktioniert nicht, wenn ein Boss in der Nähe ist
		10 Minuten Abklingzeit
		'Ein Illusionist ohne Zuhause ist nur ein Gespenst'
		'''
}

KoiTotem: {
	DisplayName: Koi-Totem
	Tooltip:
		'''
		Erhöht die Angelfertigkeit, wenn getragen oder in der Nähe platziert
		Das Totem spuckt gelegentlich den verwendeten Köder wieder aus, zur Wiederverwendung

		'''
}

BismiteShield: {
	DisplayName: Giftiger Tartsche
	Tooltip:
		'''
		Von einem Gegner getroffen zu werden verursacht Eiternde Wunden
		Erhöht die Verteidigung um 2 für jeden betroffenen Gegner in der Nähe des Spielers
		Dieser Effekt stapelt sich bis zu fünfmal
		'''
}

BloodfireShield: {
	DisplayName: Schild des Blutfeuers
	Tooltip:
		'''
		Verringert die Lebensregeneration auf 0
		Erhöht das maximale Leben um 40
		'''
}

ClatterboneShield: {
	DisplayName: Inbrünstiger Beschützer
	Tooltip:
		'''
		Erhöht die Verteidigung um 2 und verlangsamt die Bewegungsgeschwindigkeit um 3% für jeden nahen Feind
		Dieser Effekt stapelt sich bis zu fünfmal
		'Da ist etwas Besonderes zwischen uns'
		'''
}

ExplorerTreads: {
	DisplayName: Sohlen des Entdeckers
