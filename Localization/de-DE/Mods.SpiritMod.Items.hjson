AceOfClubs: {
	DisplayName: Kreuz-Ass
	Tooltip: Kritische Treffer lassen Gegner Geld fallen lassen
}

AceOfDiamonds: {
	DisplayName: Karo-Ass
	Tooltip:
		'''
		Kritische Treffer haben eine Chance, Karo-Asse fallen zu lassen
		Karo-Asse gewähren beim Einsammeln 20% erhöhten Schaden für 5 Sekunden
		'''
}

AceOfHearts: {
	DisplayName: Herz-Ass
	Tooltip: Kritische Treffer haben eine Chance, Herzen fallen zu lassen
}

AceOfSpades: {
	DisplayName: Pik-Ass
	Tooltip: Kritische Treffer verursachen zusätzlichen Schaden.
}

DiamondAce: {
	DisplayName: Karo-Ass
	Tooltip: Das solltest du nicht sehen
}

FourOfAKind: {
	DisplayName: Vierling
	Tooltip:
		'''
		Kritische Treffer verursachen zusätzlichen Schaden und lassen Geld fallen
		Kritische Treffer haben eine Chance, ein Karo-Ass oder Herz fallen zu lassen
		'''
}

AssassinMagazine: {
	DisplayName: Magazin des Assassinen
	Tooltip:
		'''
		Doppeltipp {0} während du eine Fernkampfwaffe hältst, um die Munitionsart zu wechseln
		Funktioniert auch im Inventar
		'''
}

Bauble: {
	DisplayName: Winterlicher Flitter
	Tooltip:
		'''
		Verteidigungs- und Bewegungsfähigkeiten sind erhöht, wenn unter halbem Leben
		Unter halbes Leben zu fallen erzeugt einen Schild, der 6 Sekunden lang Projektile neutralisiert
		1 Minute Abklingzeit
		'''
}

BowSummonItem: {
	DisplayName: Unglücksbogen
	Tooltip:
		'''
		Beschwört einen besessenen Bogen, der für dich kämpft
		Verwendet den ersten Pfeil in deinem Inventar
		Ohne Pfeile schießt er endlos schwächere Narrenpfeile ab
		Der Bogen belegt keine Dienerplätze
		'''
}

ChaosCrystal: {
	DisplayName: Chaoskristall
	Tooltip: Ein Treffer hat eine Chance, dich in die Nähe zu teleportieren
}

CimmerianScepter: {
	DisplayName: Zimmerisches Zepter
	Tooltip:
		'''
		Beschwört ein magisches Zepter, das für dich kämpft
		Das Zepter nutzt eine Vielzahl von Angriffen gegen Feinde
		Dieses Zepter belegt keine Dienerplätze
		'''
}

CleftHorn: {
	DisplayName: Gespaltenes Horn
	Tooltip:
		'''
		Erhöht Rüstungsdurchdringung um 3
		Nahkampfangriffe treffen Gegner gelegentlich doppelt
		'''
}

CultistScarf: {
	DisplayName: Schal aus Uraltgeflecht
	Tooltip:
		'''
		20% verringerter Manaverbrauch unter halbem Leben
		Erhöht das maximale Mana um 120 über halbem Leben
		9% erhöhte kritische Magiechance
		Magieangriffe setzen gelegentlich Bolzen mächtiger Uralter Magie frei, die von Wänden abprallen
		'''
}

CursedPendant: {
	DisplayName: Verfluchter Anhänger
	Tooltip:
		'''
		6% erhöhter Nahkampfschaden
		Waffen haben eine 15%-Chance, Verfluchtes Inferno zu verursachen
		'''
}

DarkfeatherVisage: {
	DisplayName: Dunkelfeder-Antlitz
	Tooltip:
		'''
		Erhöht Magie- und Beschwörungsschaden um 7%
		Gewährt einen Bonus, wenn zusammen mit einer Magierobe oder einem Pelzmantel getragen
		'''
}

Dartboard: {
	DisplayName: Dartscheibe
	Tooltip:
		'''
		13% verringerter Schaden
		15% erhöhte kritische Trefferchance
		'Genau ins Schwarze'
		'''
}

DesertSlab: {
	DisplayName: Uralte Steinplatte
	Tooltip: Gewährt Immunität gegen den 'Mächtiger Wind'-Debuff während Sandstürmen
}

ElectricGuitar: {
	DisplayName: E-Gitarre
