BossChecklistIntegration: {
	JellyDeluge: {
		EntryName: Gelee-Flut
		SpawnInfo: Tritt auf natürliche Weise über der Erde auf, nachdem irgendein Boss besiegt wurde. Kann auch durch Verwendung eines [i:SpiritMod/DistressJellyItem] beschworen werden, das im Asteroiden-Biom zu finden und mit einem Insektennetz zu fangen ist. Tritt seltener auf, nachdem der Mondgelee-Zauberer besiegt wurde.
	}

	TheTide: {
		EntryName: Die Gezeiten
		SpawnInfo: Verwende jederzeit eine [i:SpiritMod/BlackPearl] am Ozean.
	}

	MysticMoon: {
		EntryName: Mystischer Mond
		SpawnInfo: Verwende nachts einen [i:SpiritMod/BlueMoonSpawn].
	}
}

GameTips: {
	SpiritGameTip0: Mondgelee ist eine großartige Heilquelle!
	SpiritGameTip1: Der Aufseher kommt nicht zurück!
	SpiritGameTip2: Du kannst den Abenteurer jederzeit im unterirdischen Dorngestrüpp finden.
	SpiritGameTip3: Mystische Schreine bieten viele Vorteile - oder Gefahren!
	SpiritGameTip4: Das Juwel birgt unermessliche Macht. Hast du, was es dafür braucht?
	SpiritGameTip5: Besiege den Starplate Voyager, um Astralit zu erhalten, ein mächtiges Weltraummetall.
	SpiritGameTip6: Der Ozean steckt voller Überraschungen. Wirf mal einen Blick hinein!
	SpiritGameTip7: Keulen sind großartige Nahkampfwaffen, besonders wenn viele Gegner auf Abstand gehalten werden müssen.
	SpiritGameTip8: Die tief unterirdischen Grabmäler sind gefährlich, aber lohnen sich sehr.
	SpiritGameTip9: Quests sind ein einfacher Weg, um jede Menge Belohnungen zu bekommen - sprich mit dem Abenteurer, um das Buch zu erhalten!
}

AvianIslandSigns: {
	0: (der Text ist unleserlich)
	1: Schwebendes Resort - Das einzige (Kratzspuren)
	2: Aufseher in der Ferne gesichtet? Mehr auf Seite 5
	3: Eine Wiederbelebung? Wahrscheinlicher, als du denkst!
	4: Finde mehr (Kratzspuren) und das für nur 50g!
}

