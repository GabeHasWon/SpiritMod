SpiritClientConfig: {
	DisplayName: Клиентская конфигурация

	ScreenShake: {
		Label: Сила тряски экрана
		Tooltip: Определяет уровень силы тряски экрана, создаваемой контентом Spirit.
	}

	DistortionConfig: {
		Label: Искривление экрана
		Tooltip: Добавляет эффект искривления экрана для биома духов и битвы с Звездопанцирным странником.
	}

	ForegroundParticles: {
		Label: Летающие перед экраном частицы
		Tooltip: Добавляет эффект летающих перед экраном частиц для биома духов и некоторых ситуаций.
	}

	AutoReuse: {
		Label: Строчка про автоатаку в описании оружия
		Tooltip: Добавляет к описанию каждого оружия дополнительную строчку о том, есть ли у него автоатака или нет.
	}

	QuickSell: {
		Label: Механика быстрой продажи предметов
		Tooltip: Добавляет механику быстрой продажи всех ненужных предметов с помощью новой кнопки в меню торговли с НИПами.
	}

	AmbientSounds: {
		Label: Звуковые эффекты
		Tooltip: Добавляет новые звуковые эффекты для некоторых биомов.
	}

	LeafFall: {
		Label: Эффект падающей листвы
		Tooltip:
			'''
			Добавляет фоновый эффект падающей листвы для тихих ночей и терновника.
			Может вызывать различные визуальные баги при игре с Terraria Overhaul.
			'''
	}

	QuestBookLocation: {
		Label: Расположение книги заданий
		Tooltip: Определяет, в какой части инвентаря будет отображаться кнопка открытия книги заданий.
	}

	QuestBookSwitching: {
		Label: Переключение на вкладку открытого задания
		Tooltip: Автоматически перебрасывает вас на соответствующую вкладку, если задание, которое было у вас открыто, перешло во вкладку активных или завершённых.
	}

	ShowNPCQuestNotice: {
		Label: Восклицательный знак над НИПами
		Tooltip: Добавляет иконку восклицательного знака над НИПами, у которых появилось новое задание.
	}

	DoubleHideoutGeneration: {
		Label: Генерация таинственной башни и укрытия бандитов в одном мире
		Tooltip:
			'''
			Позволяет генерировать в новых мирах обе структуры, а не только одну.
			Рекомендуется включать только для больших миров.
			'''
	}

	OceanShape: {
		Label: Форма океана
		Tooltip:
			'''
			Определяет тип генерации океана.
			Рекомендуется использовать тип «Кусочная (V)» для прохождения мода.
			'''
	}

	VentCritters: {
		Label: Живность возле гидротермальных источников
		Tooltip:
			'''
			Позволяет различной живности появляться рядом с гидротермальными источниками.
			Эта живность не влияет на частоту появления обычных врагов, но засчитывается в общем лимите существ в мире.
			'''
	}

	SurfaceWaterTransparency: {
		Label: Прозрачная вода в океане
		Tooltip:
			'''
			Делает воду в океане более прозрачной.
			Эта настройка не влияет на воду из других биомом.
			'''
	}

	EnemyFishing: {
		Label: Вылавливание врагов удочкой
		Tooltip: Позволяет вылавливать некоторых новых врагов во время рыбалки.
	}

	AuroraEnabled: {
		Label: Эффект северного сияния
		Tooltip: Добавляет эффекты северного сияния во время соответствующего события.
	}

	EnableSepulchres: {
		Label: Тёмные склепы
		Tooltip:
			'''
			Включает генерацию тёмных склепов в новых мирах.
			Отключите, если тёмные склепы вызывают проблемы при игре с другими модами.
			'''
	}

	ForceClassicZiggurat: {
		Label: Принудительная генерация зиккурата из Spirit Classic
		Tooltip:
			'''
			Заставляет зиккурат из Spirit Classic генерироваться в новых мирах даже с включённым Spirit Reforged.
			Этот зиккурат может перекрывать другие структуры при неудачной генерации.
			'''
	}

	Headers: {
		Visuals: "[i:SpiritMod/MoonStone] Визуальные эффекты"
		QoL: "[i:SpiritMod/PirateCrate] Удобства"
		Ambience: "[i:SpiritMod/GladeWreath] Звуковые эффекты"
		Quests: "[i:SpiritMod/MapScroll] Задания"
		Generation: "[i:SpiritMod/BismiteCrystal] Генерация мира"
		Oceans: "[i:SpiritMod/BlackPearl] Океан"
		Fishing: "[i:SpiritMod/HornetfishQuest] Рыбалка"
	}
}

QuestInvLocation: {
	Tooltip: ""

	Minimap: {
		Label: У мини-карты
		Tooltip: ""
	}

	Trashcan: {
		Label: У мусорки
		Tooltip: ""
	}

	FarLeft: {
		Label: Слева
		Tooltip: ""
	}
}

OceanShape: {
	Tooltip: ""

	Default: {
		Label: Стандартная
		Tooltip: Ванильная генерация океана. Отключает все изменения из Spirit.
	}

	SlantedSine: {
		Label: Синусоида
		Tooltip: Генерация океана, определяемая наклонённой синусоидой волной.
	}

	Piecewise: {
		Label: Кусочная
		Tooltip: Более сложная генерация океана, определяемая кусочно-заданной функцией.
	}

	Piecewise_M: {
		Label: Кусочная (M)
		Tooltip: Генерация на основе кусочно-заданной функции с немного изменённой крутизной на отдельных участках.
	}

	Piecewise_V: {
		Label: Кусочная (V)
		Tooltip: Финальная версия генерации на основе кусочно-заданной функции с небольшими изменениями. Установлена по умолчанию.
	}
}

